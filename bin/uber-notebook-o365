#!/usr/bin/env python3
"""Two-way sync: Uber Notebook calendar <-> Office 365 calendar (Microsoft Graph).

  uber-notebook-o365 login          sign in (device code), once, in a terminal
  uber-notebook-o365 login-start    the device code as JSON (Settings shows it)
  uber-notebook-o365 login-finish   waits for that sign-in to go through
  uber-notebook-o365 logout         forgets the sign-in
  uber-notebook-o365 sync           run one sync (--dry-run: only show what would happen)
  uber-notebook-o365 status         sign-in, mapping and settings (--json for Settings)
  uber-notebook-o365 config <key> <value>   enabled true|false, interval <minutes>

Synced fields: title, start, end, all-day, place. Conflicts: last modified wins.
Recurring events: Office 365 -> Notebook only (daily/weekly/weekdays/monthly/yearly);
recurring events created in the Notebook are not pushed (the Notebook's event list
does not expose their recurrence rule). Only the profile the sync was set up with
is synced; with another profile open it waits.

Everything is kept in ~/.local/state/o365-sync: token.json (0600), map.json (which
event is which), config.json (Settings) and last.json (the last run's result).
This file is part of the henninger80 fork of Uber Notebook and talks to the
Notebook only through its public IPC commands (omarchy-shell uber-notebook ...).
"""
import argparse, fcntl, hashlib, json, os, shutil, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo

CLIENT_ID = os.environ.get("O365_CLIENT_ID", "14d82eec-204b-4c2f-b7e8-296a70dab67e")  # Microsoft Graph CLI
TENANT = os.environ.get("O365_TENANT", "common")
SCOPE = "Calendars.ReadWrite offline_access"
STATE_DIR = os.path.expanduser("~/.local/state/o365-sync")
TOKEN_FILE = os.path.join(STATE_DIR, "token.json")
MAP_FILE = os.path.join(STATE_DIR, "map.json")
CONFIG_FILE = os.path.join(STATE_DIR, "config.json")
LAST_FILE = os.path.join(STATE_DIR, "last.json")
PENDING_FILE = os.path.join(STATE_DIR, "login-pending.json")
LOCK_FILE = os.path.join(STATE_DIR, "sync.lock")
GRAPH = "https://graph.microsoft.com/v1.0"
LOGIN = f"https://login.microsoftonline.com/{TENANT}/oauth2/v2.0"
PAST_DAYS, FUTURE_DAYS = 30, 365
DEFAULT_CONFIG = {"enabled": True, "interval": 10, "profile": ""}


def shell_cmd():
    # (Run from the shell's own panel, PATH is /usr/bin alone and OMARCHY_PATH unset.)
    if not os.environ.get("OMARCHY_PATH") and os.path.isfile("/usr/share/omarchy/shell/shell.qml"):
        os.environ["OMARCHY_PATH"] = "/usr/share/omarchy"
    found = shutil.which("omarchy-shell")
    if found:
        return found
    for p in ("/usr/share/omarchy/bin/omarchy-shell", "/usr/bin/omarchy-shell"):
        if os.path.exists(p):
            return p
    return "omarchy-shell"


NB = [shell_cmd(), "uber-notebook"]


def local_tz_name():
    try:
        p = os.path.realpath("/etc/localtime")
        return p.split("zoneinfo/")[1]
    except Exception:
        return "UTC"


TZ_NAME = local_tz_name()
TZ = ZoneInfo(TZ_NAME)


class Failure(Exception):
    """A run that can't go on: said in one line, no traceback."""


def log(*a):
    print(*a, flush=True)


def write_json(path, data, private=False):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600 if private else 0o644)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


# ---------- settings ----------
def load_config():
    c = dict(DEFAULT_CONFIG)
    got = read_json(CONFIG_FILE, {})
    if isinstance(got, dict):
        c.update({k: v for k, v in got.items() if k in DEFAULT_CONFIG})
    c["enabled"] = c["enabled"] is True
    try:
        c["interval"] = max(5, min(240, int(c["interval"])))
    except Exception:
        c["interval"] = DEFAULT_CONFIG["interval"]
    c["profile"] = str(c["profile"] or "")
    return c


def set_config(key, value):
    c = load_config()
    if key == "enabled":
        c["enabled"] = value.lower() in ("1", "true", "yes", "on")
    elif key == "interval":
        c["interval"] = int(value)
    elif key == "profile":
        c["profile"] = value
    else:
        raise Failure("the settings are enabled, interval and profile")
    write_json(CONFIG_FILE, c)
    return load_config()


# ---------- Microsoft auth ----------
def http(method, url, data=None, headers=None, form=False):
    h = dict(headers or {})
    body = None
    if data is not None:
        if form:
            body = urllib.parse.urlencode(data).encode()
            h["Content-Type"] = "application/x-www-form-urlencoded"
        else:
            body = json.dumps(data).encode()
            h["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=h, method=method)
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            raw = r.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        raw = e.read().decode(errors="replace")
        try:
            return {"_error": json.loads(raw), "_status": e.code}
        except Exception:
            return {"_error": raw, "_status": e.code}
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        reason = getattr(e, "reason", e)
        raise Failure(f"Office 365 isn't reachable ({reason})")


def save_token(tok):
    tok["obtained"] = time.time()
    write_json(TOKEN_FILE, tok, private=True)


def login_start():
    dc = http("POST", LOGIN + "/devicecode", {"client_id": CLIENT_ID, "scope": SCOPE}, form=True)
    if "device_code" not in dc:
        raise Failure(f"device code failed: {dc.get('_error', dc)}")
    pending = {"device_code": dc["device_code"], "interval": dc.get("interval", 5),
               "expires": time.time() + dc["expires_in"]}
    write_json(PENDING_FILE, pending, private=True)
    return {"user_code": dc["user_code"], "verification_uri": dc["verification_uri"],
            "message": dc["message"], "expires_in": dc["expires_in"]}


def login_finish():
    pending = read_json(PENDING_FILE, None)
    if not pending:
        raise Failure("no sign-in started (login-start first)")
    try:
        while time.time() < pending["expires"]:
            time.sleep(pending.get("interval", 5))
            r = http("POST", LOGIN + "/token", {
                "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                "client_id": CLIENT_ID, "device_code": pending["device_code"]}, form=True)
            if "access_token" in r:
                save_token(r)
                return
            err = r.get("_error", {})
            code = err.get("error") if isinstance(err, dict) else ""
            if code == "slow_down":
                pending["interval"] = pending.get("interval", 5) + 5
            elif code != "authorization_pending":
                raise Failure(f"sign-in failed: {err.get('error_description', err) if isinstance(err, dict) else err}")
        raise Failure("sign-in timed out")
    finally:
        try:
            os.remove(PENDING_FILE)
        except FileNotFoundError:
            pass


def logout():
    for p in (TOKEN_FILE, PENDING_FILE):
        try:
            os.remove(p)
        except FileNotFoundError:
            pass


def access_token():
    tok = read_json(TOKEN_FILE, None)
    if not tok:
        raise Failure("not signed in to Office 365")
    if time.time() < tok["obtained"] + tok.get("expires_in", 3600) - 120:
        return tok["access_token"]
    r = http("POST", LOGIN + "/token", {
        "grant_type": "refresh_token", "client_id": CLIENT_ID,
        "refresh_token": tok["refresh_token"], "scope": SCOPE}, form=True)
    if "access_token" not in r:
        raise Failure("the Office 365 sign-in has run out: sign in again")
    r.setdefault("refresh_token", tok["refresh_token"])
    save_token(r)
    return r["access_token"]


def graph(method, path, data=None, extra=None):
    h = {"Authorization": "Bearer " + access_token(),
         "Prefer": f'outlook.timezone="{TZ_NAME}", outlook.body-content-type="text"'}
    h.update(extra or {})
    url = path if path.startswith("http") else GRAPH + path
    r = http(method, url, data, h)
    if "_error" in r:
        raise RuntimeError(f"Graph {method} {path}: {r['_status']} {r['_error']}")
    return r


# ---------- Notebook ----------
def nb(*args, retries=4):
    for _ in range(retries):
        try:
            p = subprocess.run(NB + [str(a) for a in args], capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise Failure(f"Uber Notebook isn't answering ({e})")
        try:
            r = json.loads(p.stdout)
        except Exception:
            raise RuntimeError(f"notebook {args}: {p.stdout!r} {p.stderr!r}")
        if isinstance(r, dict) and r.get("ok") is False:
            if "again" in str(r.get("error", "")) or "not responding" in str(r.get("error", "")):
                time.sleep(2)
                continue
            raise RuntimeError(f"notebook {args}: {r}")
        if isinstance(r, dict) and "file" in r and "note" in r:  # long answers come as a file
            with open(r["file"]) as f:
                return json.load(f)
        return r
    raise Failure(f"Uber Notebook isn't ready ({args[0]})")


def open_profile():
    for p in nb("profiles"):
        if p.get("open"):
            return p
    return None


def nb_events(d0, d1):
    r = nb("events", d0.isoformat(), d1.isoformat())
    out = {}
    for e in r["events"]:
        cur = out.get(e["id"])
        if cur is None or e["start"] < cur["start"]:  # first occurrence in the window
            out[e["id"]] = e
    return out


def norm(e):
    """canonical comparable form (all-day end inclusive, as the Notebook has it)."""
    return {"title": (e["title"] or "").strip(), "start": e["start"], "end": e["end"],
            "allDay": bool(e["allDay"]), "place": (e.get("place") or "").strip()}


def fp(n, recurring=False):
    d = dict(n)
    if recurring:  # occurrence dates aren't comparable across windows
        d = {"title": d["title"], "place": d["place"]}
    return hashlib.sha1(json.dumps(d, sort_keys=True).encode()).hexdigest()


# ---------- Graph <-> normalized ----------
def g_norm(g):
    all_day = g.get("isAllDay", False)
    s = g["start"]["dateTime"][:19]
    e = g["end"]["dateTime"][:19]
    place = ((g.get("location") or {}).get("displayName", "") or "").strip()
    if all_day:
        s = s[:10]
        e = (date.fromisoformat(e[:10]) - timedelta(days=1)).isoformat()
        if e < s:
            e = s
        return {"title": (g.get("subject") or "").strip(), "start": s, "end": e, "allDay": True, "place": place}
    return {"title": (g.get("subject") or "").strip(), "start": s[:16], "end": e[:16], "allDay": False, "place": place}


def g_body(n):
    if n["allDay"]:
        s = n["start"][:10]
        e = (date.fromisoformat(n["end"][:10]) + timedelta(days=1)).isoformat()
        st, en = s + "T00:00:00", e + "T00:00:00"
    else:
        st, en = n["start"] + ":00", n["end"] + ":00"
    return {"subject": n["title"], "isAllDay": n["allDay"],
            "start": {"dateTime": st, "timeZone": TZ_NAME},
            "end": {"dateTime": en, "timeZone": TZ_NAME},
            "location": {"displayName": n["place"]}}


def g_repeat(g):
    rec = g.get("recurrence")
    if not rec:
        return ""
    p = rec["pattern"]
    t, iv = p.get("type"), p.get("interval", 1)
    if iv != 1:
        return None
    if t == "daily":
        return "daily"
    if t == "weekly":
        days = [d.lower() for d in p.get("daysOfWeek", [])]
        if sorted(days) == ["friday", "monday", "thursday", "tuesday", "wednesday"]:
            return "weekdays"
        return "weekly" if len(days) <= 1 else None
    if t == "absoluteMonthly":
        return "monthly"
    if t == "absoluteYearly":
        return "yearly"
    return None


def g_recurring_active(g, today):
    r = g["recurrence"]["range"]
    return r.get("type") == "noEnd" or r.get("endDate", "9999") >= today.isoformat()


def fetch_graph(today):
    r = graph("GET", "/me/events?$top=100&$select=id,subject,start,end,isAllDay,location,"
                     "recurrence,type,lastModifiedDateTime,isCancelled")
    items = []
    while True:
        items += r.get("value", [])
        if "@odata.nextLink" not in r:
            break
        r = graph("GET", r["@odata.nextLink"])
    lo = (today - timedelta(days=PAST_DAYS)).isoformat()
    hi = (today + timedelta(days=FUTURE_DAYS)).isoformat()
    out, complex_ids = {}, set()
    for g in items:
        if g.get("isCancelled") or g.get("type") in ("occurrence", "exception"):
            continue
        if g.get("type") == "seriesMaster":
            if not g_recurring_active(g, today):
                continue
            if g_repeat(g) is None:
                complex_ids.add(g["id"])
                continue
        else:
            if g["end"]["dateTime"][:10] < lo or g["start"]["dateTime"][:10] > hi:
                continue
        out[g["id"]] = g
    # series the Notebook can't express (every 2 weeks, 2nd Tuesday, ...): single events per occurrence
    if complex_ids:
        q = urllib.parse.urlencode({"startDateTime": lo + "T00:00:00", "endDateTime": hi + "T00:00:00",
                                    "$top": 100, "$select": "id,subject,start,end,isAllDay,location,"
                                    "type,lastModifiedDateTime,isCancelled,seriesMasterId"}, quote_via=urllib.parse.quote)
        r = graph("GET", "/me/calendarView?" + q)
        n = 0
        while True:
            for g in r.get("value", []):
                if g.get("seriesMasterId") in complex_ids and not g.get("isCancelled"):
                    out[g["id"]] = g
                    n += 1
            if "@odata.nextLink" not in r:
                break
            r = graph("GET", r["@odata.nextLink"])
        log(f"  ({len(complex_ids)} complex series expanded into {n} single events)")
    return out


# ---------- Notebook writers ----------
def nb_create(n, repeat=""):
    s = date.fromisoformat(n["start"][:10])
    r = nb("addEvent", f"Sync {s.strftime('%b')} {s.day} 12:00", repeat)
    eid = r["id"]
    nb_update(eid, n, None)
    return eid


def nb_update(eid, n, old):
    def set_(k, v):
        nb("editEvent", eid, k, v)
    if old is None or old["allDay"] != n["allDay"]:
        set_("allDay", "true" if n["allDay"] else "false")
    set_("title", n["title"])
    set_("start", n["start"])
    set_("end", n["end"])
    set_("place", n["place"])


# ---------- sync ----------
def load_map():
    m = read_json(MAP_FILE, None)
    return m if isinstance(m, dict) and isinstance(m.get("links"), list) else {"links": [], "last_sync": 0}


def check_profile(cfg):
    """The open profile is the one the sync is for (the first one synced, if none is set yet)."""
    p = open_profile()
    if p is None:
        raise Failure("no profile is open in Uber Notebook")
    if p.get("demo"):
        raise Failure("the demo profile is open: not synced")
    if not cfg["profile"]:
        set_config("profile", p["id"])
        log(f"Syncing profile {p.get('name')!r} from now on.")
        return p
    if p["id"] != cfg["profile"]:
        raise Failure(f"profile {p.get('name')!r} is open, not the synced one: waiting")
    return p


def sync(dry):
    cfg = load_config()
    check_profile(cfg)
    today = date.today()
    d0, d1 = today - timedelta(days=PAST_DAYS), today + timedelta(days=FUTURE_DAYS)
    m = load_map()
    links = m["links"]
    last = m.get("last_sync", 0)
    now = time.time()
    mid = (last + now) / 2 if last else now

    log("Fetching Office 365 …")
    G = fetch_graph(today)
    log("Fetching Notebook …")
    N = nb_events(d0, d1)

    stats = dict(to_nb=0, to_g=0, upd_nb=0, upd_g=0, del_nb=0, del_g=0, skipped=0, errors=0)

    # deletions
    removed_g, removed_n = set(), set()
    gone = []
    for l in links:
        in_win = d0.isoformat() <= l["start"][:10] <= d1.isoformat() or l["recurring"]
        g_missing = l["g"] not in G
        n_missing = l["nb"] not in N and in_win
        if g_missing or n_missing:
            gone.append((l, g_missing, n_missing))
    if links and len(gone) > max(5, len(links) // 2):
        raise Failure(f"stopped: {len(gone)} of {len(links)} linked events vanished at once (safety guard)")
    for l, g_missing, n_missing in gone:
        if g_missing and not n_missing:
            log(f"  - delete in Notebook: {l['title']}")
            if not dry:
                try:
                    nb("removeEvent", l["nb"])
                except RuntimeError as e:
                    log("    ", e)
                    stats["errors"] += 1
            stats["del_nb"] += 1
        elif n_missing and not g_missing:
            log(f"  - delete in Office 365: {l['title']}")
            if not dry:
                try:
                    graph("DELETE", "/me/events/" + l["g"])
                except RuntimeError as e:
                    log("    ", e)
                    stats["errors"] += 1
            stats["del_g"] += 1
        links.remove(l)
        removed_g.add(l["g"])
        removed_n.add(l["nb"])
    byn = {l["nb"]: l for l in links}
    byg = {l["g"]: l for l in links}

    # linked events: propagate changes
    for l in links:
        g, n = G[l["g"]], N.get(l["nb"])
        if n is None:
            continue  # outside window
        rec = l["recurring"]
        gn, nn = g_norm(g), norm(n)
        gh, nh = fp(gn, rec), fp(nn, rec)
        g_changed, n_changed = gh != l["hash"], nh != l["hash"]
        if gh == nh:
            l["hash"], l["title"], l["start"] = gh, gn["title"], gn["start"]
            continue
        if g_changed and n_changed:
            g_mod = datetime.fromisoformat(g["lastModifiedDateTime"].replace("Z", "+00:00")).timestamp()
            use_g = g_mod >= mid
        else:
            use_g = g_changed
        try:
            if use_g:
                log(f"  ↓ update Notebook: {gn['title']}")
                if not dry:
                    if rec:
                        nb("editEvent", l["nb"], "title", gn["title"])
                        nb("editEvent", l["nb"], "place", gn["place"])
                    else:
                        nb_update(l["nb"], gn, nn)
                stats["upd_nb"] += 1
                l["hash"] = fp(gn, rec)
            else:
                if rec:  # recurring master edited in the Notebook: only title/place can go up
                    body = {"subject": nn["title"], "location": {"displayName": nn["place"]}}
                else:
                    body = g_body(nn)
                log(f"  ↑ update Office 365: {nn['title']}")
                if not dry:
                    graph("PATCH", "/me/events/" + l["g"], body)
                stats["upd_g"] += 1
                l["hash"] = fp(nn, rec)
        except RuntimeError as e:  # tried again next run (the hash is left as it was)
            log("    ", e)
            stats["errors"] += 1
            continue
        l["title"], l["start"] = (gn if use_g else nn)["title"], (gn if use_g else nn)["start"]

    # new on Office 365 -> Notebook
    for gid, g in G.items():
        if gid in byg or gid in removed_g:
            continue
        gn = g_norm(g)
        rep = g_repeat(g) if g.get("type") == "seriesMaster" else ""
        log(f"  ↓ new in Notebook: {gn['title']} ({gn['start']}){' ' + rep if rep else ''}")
        try:
            eid = "dry-" + gid if dry else nb_create(gn, rep)
        except RuntimeError as e:
            log("    ", e)
            stats["errors"] += 1
            continue
        links.append({"nb": eid, "g": gid, "hash": fp(gn, bool(rep)), "title": gn["title"],
                      "start": gn["start"], "recurring": bool(rep)})
        stats["to_nb"] += 1
        if not dry:  # each new link kept at once: a run cut short makes no twins
            save_map(m, links, last)

    # new in Notebook -> Office 365
    for nid, n in N.items():
        if nid in byn or nid in removed_n:
            continue
        if n.get("repeats"):
            stats["skipped"] += 1
            log(f"  (skip recurring Notebook event, not pushed: {n['title']})")
            continue
        nn = norm(n)
        log(f"  ↑ new in Office 365: {nn['title']} ({nn['start']})")
        gid = "dry-" + nid
        if not dry:
            try:
                gid = graph("POST", "/me/events", g_body(nn))["id"]
            except RuntimeError as e:
                log("    ", e)
                stats["errors"] += 1
                continue
        links.append({"nb": nid, "g": gid, "hash": fp(nn), "title": nn["title"],
                      "start": nn["start"], "recurring": False})
        stats["to_g"] += 1
        if not dry:
            save_map(m, links, last)

    if not dry:
        save_map(m, links, now)
    return stats


def save_map(m, links, last_sync):
    m["links"], m["last_sync"] = links, last_sync
    write_json(MAP_FILE, m)


def status_data():
    cfg = load_config()
    tok = read_json(TOKEN_FILE, None)
    m = load_map()
    return {"signedIn": bool(tok and tok.get("refresh_token")), "signingIn": os.path.exists(PENDING_FILE),
            "links": len(m["links"]), "lastSync": m.get("last_sync", 0), "config": cfg,
            "last": read_json(LAST_FILE, None)}


def run_sync(dry, as_json):
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("Another sync is running.")
        if as_json:
            print(json.dumps({"ok": False, "busy": True, "error": "another sync is running"}))
        return 3
    started = time.time()
    try:
        stats = sync(dry)
        result = {"ok": stats["errors"] == 0, "at": started, "stats": stats, "dry": dry,
                  "error": f"{stats['errors']} change(s) failed, tried again next time" if stats["errors"] else ""}
        code = 0
    except Failure as e:
        result = {"ok": False, "at": started, "error": str(e), "dry": dry}
        code = 2
    except Exception as e:  # anything else: kept short for Settings, whole in the log
        result = {"ok": False, "at": started, "error": f"{type(e).__name__}: {e}"[:400], "dry": dry}
        code = 1
    if not dry:
        write_json(LAST_FILE, result)
    if "stats" in result:
        log("Done:", ", ".join(f"{k}={v}" for k, v in result["stats"].items()), "(dry run)" if dry else "")
    else:
        log("Failed:", result["error"])
    if as_json:
        print(json.dumps(result))
    return code


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["login", "login-start", "login-finish", "logout", "sync", "status", "config"])
    ap.add_argument("args", nargs="*")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true", help="a JSON line at the end, for Settings")
    a = ap.parse_args()
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        if a.cmd == "sync":
            return run_sync(a.dry_run, a.json)
        if a.cmd == "login":
            info = login_start()
            log(info["message"])
            login_finish()
            log("Login OK.")
        elif a.cmd == "login-start":
            print(json.dumps(login_start()))
        elif a.cmd == "login-finish":
            login_finish()
            print(json.dumps({"ok": True}))
        elif a.cmd == "logout":
            logout()
            print(json.dumps({"ok": True}))
        elif a.cmd == "config":
            if len(a.args) != 2:
                raise Failure("config <key> <value>")
            print(json.dumps(set_config(a.args[0], a.args[1])))
        else:
            s = status_data()
            if a.json:
                print(json.dumps(s))
            else:
                log("Signed in" if s["signedIn"] else "Not signed in", "· sync", "on" if s["config"]["enabled"] else "off",
                    f"every {s['config']['interval']} min")
                log(f"{s['links']} linked events; last sync:",
                    datetime.fromtimestamp(s["lastSync"]).isoformat(" ", "seconds") if s["lastSync"] else "never")
                if s["last"] and not s["last"].get("ok"):
                    log("Last run:", s["last"].get("error"))
        return 0
    except Failure as e:
        if a.json or a.cmd in ("login-start", "login-finish", "logout", "config"):
            print(json.dumps({"ok": False, "error": str(e)}))
        else:
            log("Failed:", e)
        return 2


if __name__ == "__main__":
    sys.exit(main())
